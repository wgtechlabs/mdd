{
  "name": "@wgtechlabs/mdd",
  "version": "0.1.0",
  "private": true,
  "description": "Build and host documentation from Markdown with mdd-engine",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wgtechlabs/mdd.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.10",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "themes/d",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome check src tests assets themes scripts package.json tsconfig.json tsconfig.build.json biome.json",
    "format": "biome check --write src tests assets themes scripts package.json tsconfig.json tsconfig.build.json biome.json",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test",
    "coverage": "bun run build && bun test --coverage",
    "build": "bun scripts/build.mjs",
    "check": "bun run lint && bun run typecheck && bun run test",
    "smoke": "node scripts/package-smoke.mjs",
    "demo": "bun run build && node scripts/demo.mjs"
  },
  "dependencies": {
    "@wgtechlabs/mdd-engine": "1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/node": "22",
    "typescript": "7.0.2"
  }
}
